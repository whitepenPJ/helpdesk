generator client {
  provider     = "prisma-client"
  output       = "../app/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                       String             @id @default(cuid())
  name                                     String
  email                                    String             @unique
  passwordHash                             String?
  role                                     Role               @default(USER)
  status                                   UserStatus         @default(ACTIVE)
  isAssignee                               Boolean            @default(false)
  // Master User's "Options" group — lets this user pick any user as the
  // Creator on the New Ticket form (like an admin can), instead of it being
  // locked to themselves. See canChangeCreator in app/(dashboard)/tickets/new/page.tsx.
  canOpenTicketForOthers                   Boolean            @default(false)
  image                                    String?
  companyId                                String?
  departmentId                             String?
  userGroupId                              String?
  createdAt                                DateTime           @default(now())
  updatedAt                                DateTime           @updatedAt
  telephone                                String?
  // Auth.js (NextAuth) OAuth account-linking bookkeeping — unused by the
  // Credentials provider, only populated for OAuth sign-ins (e.g. Azure AD).
  emailVerified                            DateTime?
  // Last time this user opened the header notification bell — drives the
  // unread badge count on the derived TicketHistory activity feed.
  notificationsSeenAt                      DateTime?
  accounts                                 Account[]
  sessions                                 Session[]
  ApiToken                                 ApiToken[]
  AuditLog                                 AuditLog[]
  CategoryAdmin                            CategoryAdmin[]
  DepartmentApprover                       DepartmentApprover[]
  LessonLearned                            LessonLearned[]
  Notification                             Notification[]
  PushSubscription                         PushSubscription[]
  Ticket_Ticket_createdByIdToUser          Ticket[]           @relation("Ticket_createdByIdToUser")
  Ticket_Ticket_deletedByIdToUser          Ticket[]           @relation("Ticket_deletedByIdToUser")
  TicketApproval                           TicketApproval[]
  TicketAssignee                           TicketAssignee[]
  TicketComment                            TicketComment[]
  TicketHistory                            TicketHistory[]
  Company                                  Company?           @relation(fields: [companyId], references: [id])
  Department_User_departmentIdToDepartment Department?        @relation("User_departmentIdToDepartment", fields: [departmentId], references: [id])
  UserGroup                                UserGroup?         @relation(fields: [userGroupId], references: [id])

  @@index([companyId])
  @@index([departmentId])
  @@index([role])
}

// Auth.js (NextAuth) adapter models — see https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id        String   @id
  userId    String?
  action    String
  module    String
  details   Json?
  ipAddress String?
  timestamp DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])

  @@index([module])
  @@index([userId])
}

// Personal access tokens for authenticating server-to-server clients (e.g.
// the MCP server) that have no browser session to read a cookie from. Only
// a SHA-256 hash of the token is stored — the raw value is shown once, at
// creation, and never persisted.
model ApiToken {
  id         String    @id
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id                String              @id
  name              String              @unique
  description       String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  CategoryAdmin     CategoryAdmin[]
  CategoryUserGroup CategoryUserGroup[]
  Ticket            Ticket[]
}

model CategoryAdmin {
  id         String   @id
  categoryId String
  adminId    String
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  Category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, adminId])
}

model CategoryUserGroup {
  id          String    @id
  categoryId  String
  userGroupId String
  createdAt   DateTime  @default(now())
  UserGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  Category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, userGroupId])
}

model Company {
  id         String       @id
  code       String?      @unique
  name       String
  address    String?
  taxId      String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  Department Department[]
  Ticket     Ticket[]
  User       User[]
}

model Department {
  id                                 String   @id
  name                               String
  code                               String?
  companyId                          String
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime
  Company                            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  DepartmentApprover                 DepartmentApprover[]
  Ticket                             Ticket[]
  User_User_departmentIdToDepartment User[]   @relation("User_departmentIdToDepartment")

  @@unique([companyId, name])
  @@unique([companyId, code])
}

// A department can now have more than one Approver — any one of them can
// decide a ticket's approval request (first to act wins), mirroring how
// TicketAssignee lets any assignee in a pool act on a ticket. Replaces the
// old single, unique Department.supervisorId column.
model DepartmentApprover {
  id           String     @id
  departmentId String
  userId       String
  createdAt    DateTime   @default(now())
  Department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  User         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([departmentId])
  @@index([userId])
}

model LessonLearned {
  id          String   @id
  title       String
  description String
  images      String[]
  attachments String[]
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([isActive])
}

// One row per (recipient, lifecycle event) — drives the header bell/badge
// and the full /notifications page. Deliberately separate from
// TicketHistory (the ticket detail page's audit-trail Timeline tab): that
// table is a single append-only log per ticket event with one actor and one
// action string, which can't express "this event reads differently per
// recipient" (e.g. an assignment reads "assigned to you" for the assignee
// but "is assigned" for the ticket's owner). `message`/`href` are computed
// and frozen at creation time by the notify() helper in app/lib/notifications.ts
// — nothing re-derives them at read time.
model Notification {
  id        String   @id
  userId    String
  ticketId  String
  message   String
  href      String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ticketId])
}

model PushSubscription {
  id        String   @id
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id
  key       String   @unique
  value     String
  updatedAt DateTime
}

model Ticket {
  id                            String                @id
  ticketNumber                  String                @unique
  title                         String
  description                   String
  problem                       String?
  solution                      String?
  categoryId                    String
  companyId                     String
  departmentId                  String
  createdById                   String
  status                        TicketStatus          @default(NEW)
  priority                      Priority              @default(MEDIUM)
  telephone                     String?
  rating                        Rating?
  ratingComment                 String?
  ratingScore                   Int?
  // Snapshot of status right before entering WAITING (supervisor approval
  // requested), restored once the supervisor approves/rejects.
  preApprovalStatus             TicketStatus?
  attachments                   String[]
  closedAt                      DateTime?
  resolvedAt                    DateTime?
  autoCloseDueDate              DateTime?
  // Soft delete — the row (and everything cascading to it: comments,
  // history, etc.) is kept, just excluded from every list/search/report
  // query by default. Ticket Management alone can still surface
  // deletedAt-not-null rows via its "Show deleted" filter. See deleteTicket
  // in app/actions/tickets.ts.
  deletedAt                     DateTime?
  deletedById                   String?
  deletedReason                 String?
  // User-facing business date — shown/editable in place of createdAt (an
  // audit timestamp) everywhere the ticket surfaces in the UI. Defaults to
  // the moment of creation but is editable, unlike createdAt.
  transactionDate               DateTime              @default(now())
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime
  Category                      Category              @relation(fields: [categoryId], references: [id])
  Company                       Company               @relation(fields: [companyId], references: [id])
  User_Ticket_createdByIdToUser User                  @relation("Ticket_createdByIdToUser", fields: [createdById], references: [id])
  User_Ticket_deletedByIdToUser User?                 @relation("Ticket_deletedByIdToUser", fields: [deletedById], references: [id])
  Department                    Department            @relation(fields: [departmentId], references: [id])
  Notification                  Notification[]
  TicketApproval                TicketApproval?
  TicketAssignee                TicketAssignee[]
  TicketAssignedGroup           TicketAssignedGroup[]
  TicketComment                 TicketComment[]
  TicketHistory                 TicketHistory[]

  @@index([autoCloseDueDate])
  @@index([companyId, departmentId])
  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
}

model TicketApproval {
  id           String         @id
  ticketId     String         @unique
  // Who actually decided — null while PENDING, since the request now goes to
  // every one of the department's approvers (DepartmentApprover) rather than
  // one designated person; whoever acts first is recorded here.
  supervisorId String?
  status       ApprovalStatus @default(PENDING)
  // The admin's message when requesting approval. `comments` is the
  // supervisor's decision reason (approve/reject), set when `status` moves
  // off PENDING.
  requestMessage String?
  comments       String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  User           User?          @relation(fields: [supervisorId], references: [id])
  Ticket         Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TicketAssignee {
  id         String   @id
  ticketId   String
  userId     String
  assignedAt DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
}

model TicketAssignedGroup {
  id          String    @id
  ticketId    String
  userGroupId String
  assignedAt  DateTime  @default(now())
  UserGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  Ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userGroupId])
  @@index([ticketId])
  @@index([userGroupId])
}

model TicketComment {
  id          String   @id
  ticketId    String
  authorId    String
  message     String
  attachments String[]
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [authorId], references: [id])
  Ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketHistory {
  id            String   @id
  ticketId      String
  actorId       String?
  action        String
  previousState String?
  newState      String?
  timestamp     DateTime @default(now())
  User          User?    @relation(fields: [actorId], references: [id])
  Ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model UserGroup {
  id                  String                @id
  name                String                @unique
  description         String?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  CategoryUserGroup   CategoryUserGroup[]
  TicketAssignedGroup TicketAssignedGroup[]
  User                User[]
}

enum Role {
  USER
  ADMIN
  SUPERVISOR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Rating {
  NEEDS_IMPROVEMENT
  FAIRLY_SATISFIED
  FULLY_SATISFIED
}

enum TicketStatus {
  NEW
  ASSIGNED
  RESOLVED
  REOPENED
  CLOSED
  WAITING
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  // A brand-new Microsoft Entra ID sign-in with no existing account — see
  // auth.ts. Can log in and browse, but can't open a ticket (no
  // company/department to file one under yet) until an admin fills in their
  // profile and moves them to ACTIVE.
  PENDING
}
